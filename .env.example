# ==============================================================================
# RepoGuard Environment Configuration
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# General Application Settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Execution Mode
# When MOCK_MODE=true, the system bypasses heavy ML downloads (PyTorch/Transformers/FAISS)
# and uses deterministic mock components. Perfect for CPU-only laptops and fast CI tests.
MOCK_MODE=true

# Data and Artifact Directories
DATA_DIR=data
REPOS_DIR=data/repos
INDEXES_DIR=data/indexes
EXPERIMENTS_DIR=data/experiments

# Model Configuration
LLM_MODEL_NAME=Qwen/Qwen2.5-Coder-3B-Instruct
LLM_REVISION=main
LLM_DEVICE=cpu
LLM_QUANTIZATION_BITS=4
LLM_MAX_NEW_TOKENS=128
LLM_TEMPERATURE=0.1

# Retrieval Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.4
PASSAGE_CHUNK_SIZE=300
PASSAGE_CHUNK_OVERLAP=50

# Reinforcement Learning Configuration
RL_ALGORITHM=DQN
RL_STATE_DIM=18
RL_ACTION_DIM=6
RL_RISK_TOLERANCE=0.5
RL_MAX_STEPS_PER_EPISODE=6
RL_LEARNING_RATE=0.0005
RL_GAMMA=0.99
RL_BATCH_SIZE=32
RL_REPLAY_BUFFER_CAPACITY=10000

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=repoguard-experiments

# Frontend API Endpoint (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000

